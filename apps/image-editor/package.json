{
  "name": "@open-pencil/image-editor",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun node_modules/vite/bin/vite.js",
    "build": "bun node_modules/vite/bin/vite.js build",
    "measure": "bun run build && node scripts/measure-three-compositor-bundle.mjs",
    "verify": "bun run test:e2e",
    "verify:parity": "node scripts/verify-three-compositor-parity.mjs",
    "verify:soak": "node scripts/verify-three-compositor-soak.mjs",
    "verify:unknown-boundary": "node scripts/verify-g142-unknown-boundary.mjs",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun node_modules/vitest/vitest.mjs run",
    "test:e2e": "bun run build && node scripts/verify-three-compositor-demo.mjs"
  },
  "dependencies": {
    "@ch5me/ch5-ui-web": "0.10.0",
    "@open-pencil/core": "workspace:*",
    "@open-pencil/scene-graph": "workspace:*",
    "ag-psd": "^31.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@types/node": "^25.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.58.2",
    "typescript": "~5.8.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
