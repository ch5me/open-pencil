      "source": "import { createHistoryState, planHistoryRecord } from '@open-pencil/scene-graph/history'\nconst value = { map: new Map([['x', new Uint8Array([1])]]) }\nlet state = planHistoryRecord(createHistoryState<typeof value>(), { id:'history:1', label:'one', coalesceKey:'x', before:value, after:value }).next\nstate = planHistoryRecord(state, { id:'history:2', label:'two', coalesceKey:'x', before:value, after:value }).next\nconst snapshot = state.entries.get('history:2')?.before\nif (!snapshot) throw new Error('missing snapshot')\nlet blocked = 0\ntry { snapshot.map.set('y', new Uint8Array([2])) } catch { blocked++ }\ntry { snapshot.map.get('x')?.fill(9) } catch { blocked++ }\nif (blocked !== 2 || snapshot.map.get('x')?.[0] !== 1) throw new Error('immutable snapshot failed')\nconsole.log(state.undoEntryIds.length, snapshot.map.get('x')?.[0])\n"
