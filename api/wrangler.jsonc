{
  "name": "openpencil-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "25bb5f8d9ec4a36106f0ff6b519133b1",
  "workers_dev": true,
  // Real ELF (Firefly) RS256/JWKS verifier config. These are non-secret and
  // activate the canonical @ch5me/elf-auth-client verifier. Values are verified
  // against firefly-cloud's authority (packages/runtime-config production
  // hostMap + DELEGATED_SUB_APP_AUDIENCES.openpencil): tokens minted for
  // OpenPencil carry iss=https://app.elf.dance, aud=https://api.elf.dance.
  // NOTE the issuer host (app.elf.dance) differs from the JWKS/audience host
  // (api.elf.dance); a mismatch fails every real token. Never set
  // ALLOW_DEV_STUB_AUTH here — that flag is local-dev only.
  "vars": {
    "ELF_JWKS_URL": "https://api.elf.dance/.well-known/jwks.json",
    "ELF_ISSUER": "https://app.elf.dance",
    "ELF_AUDIENCE": "https://api.elf.dance"
  },
  "routes": [
    { "pattern": "api.staging.design.elf.dance/*", "zone_name": "elf.dance" },
    { "pattern": "api.design.elf.dance/*", "zone_name": "elf.dance" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openpencil-db",
      "database_id": "local-id-openpencil-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "openpencil-documents"
    },
    {
      "binding": "ASSETS",
      "bucket_name": "openpencil-assets"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["DocumentRoomDO"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCUMENT_ROOM",
        "class_name": "DocumentRoomDO"
      }
    ]
  }
}
