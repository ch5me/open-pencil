{
  "name": "openpencil-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "25bb5f8d9ec4a36106f0ff6b519133b1",
  "workers_dev": true,
  // Real ELF RS256/JWKS verifier config. These are non-secret and
  // activate the canonical @ch5me/elf-auth-client verifier. Values are verified
  // against the ELF issuer and OpenPencil audience: tokens minted for OpenPencil
  // carry iss=https://app.elf.dance, aud=https://openpencil-api.elf.dance.
  // NOTE the issuer, JWKS, and OpenPencil audience are distinct authorities;
  // a mismatch fails every real token. Never set
  // ALLOW_DEV_STUB_AUTH here — that flag is local-dev only.
  "vars": {
    "ELF_JWKS_URL": "https://api.elf.dance/.well-known/jwks.json",
    "ELF_ISSUER": "https://app.elf.dance",
    "ELF_AUDIENCE": "https://openpencil-api.elf.dance",
    "FIREFLY_API_ORIGIN": "https://api.elf.dance",
    "FIREFLY_AUTH_ORIGIN": "https://app.elf.dance"
  },
  // Top-level config is the default (production) environment: openpencil-api.elf.dance.
  "routes": [
    { "pattern": "openpencil-api.elf.dance/*", "zone_name": "elf.dance" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openpencil-db",
      "database_id": "9d83abfa-9f06-4613-95e4-0b93ce41c2c8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "openpencil-documents"
    },
    {
      "binding": "ASSETS",
      "bucket_name": "openpencil-assets"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["DocumentRoomDO"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOCUMENT_ROOM",
        "class_name": "DocumentRoomDO"
      }
    ]
  },
  // Named environments do NOT inherit bindings/vars — each stage repeats its own.
  // Staging deploys as openpencil-api-staging against staging-openpencil-api.elf.dance
  // and the openpencil-db-staging D1.
  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "ELF_JWKS_URL": "https://api.staging.elf.dance/.well-known/jwks.json",
        "ELF_ISSUER": "https://staging.app.elf.dance",
        "ELF_AUDIENCE": "https://staging-openpencil-api.elf.dance",
        "FIREFLY_API_ORIGIN": "https://api.staging.elf.dance",
        "FIREFLY_AUTH_ORIGIN": "https://staging.app.elf.dance"
      },
      "routes": [
        { "pattern": "staging-openpencil-api.elf.dance/*", "zone_name": "elf.dance" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "openpencil-db-staging",
          "database_id": "7e8af747-bef1-4fee-9431-4fc7b0108f35",
          "migrations_dir": "migrations"
        }
      ],
      // Staging MUST NOT point at the production buckets. It did until 2026-07-25:
      // both bindings named the prod bucket while `d1_databases` correctly named
      // openpencil-db-staging, so staging snapshots and assets were written into
      // production storage — and because deleteHostedDocument/deleteHostedAsset key
      // objects by userId, a staging delete could remove a production object.
      "r2_buckets": [
        {
          "binding": "DOCUMENTS",
          "bucket_name": "openpencil-documents-staging"
        },
        {
          "binding": "ASSETS",
          "bucket_name": "openpencil-assets-staging"
        }
      ],
      "migrations": [
        {
          "tag": "v1",
          "new_classes": ["DocumentRoomDO"]
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DOCUMENT_ROOM",
            "class_name": "DocumentRoomDO"
          }
        ]
      }
    }
  }
}
